#!/usr/bin/env bash
# Versioned prepare-commit-msg hook.
# Auto-prepends the branch ticket (DEV-NNNN) to the commit message subject
# when it is not already present.
#
# Arguments: $1=commit_msg_file  $2=commit_source  $3=sha1 (amend only)
#
# Skips: merge commits, squash commits, empty branches, branches without a
# recognisable ticket prefix.

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

# Skip auto-generated messages that should not be touched.
case "$COMMIT_SOURCE" in
  merge|squash) exit 0 ;;
esac

# Resolve branch name; bail gracefully on detached HEAD.
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
[ -z "${branch:-}" ] && exit 0

# Extract the leading ticket token, e.g. DEV-4921 from DEV-4921-short-name.
ticket="$(printf '%s' "$branch" | grep -oE '^[A-Z]+-[0-9]+' || true)"
[ -z "${ticket:-}" ] && exit 0

# Read the current first line of the message.
first_line="$(sed -n '1p' "$COMMIT_MSG_FILE")"

# Nothing to do if the ticket is already on the first line.
printf '%s' "$first_line" | grep -qE "^${ticket}" && exit 0

# Prepend the ticket to the first line, preserving the rest of the file.
tmp="$(mktemp)"
{
  if [ -n "${first_line:-}" ]; then
    printf '%s %s\n' "$ticket" "$first_line"
    tail -n +2 "$COMMIT_MSG_FILE"
  else
    printf '%s \n' "$ticket"
    tail -n +2 "$COMMIT_MSG_FILE"
  fi
} > "$tmp" && mv "$tmp" "$COMMIT_MSG_FILE"

exit 0
