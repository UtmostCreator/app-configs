# Generated documentation outputs (regenerate locally; do not commit)
# Keep only the README.md inside each generated folder to document the policy.
/docs/ai/generated/*
!/docs/ai/generated/README.md
!/docs/ai/generated/task-context/
/docs/ai/generated/task-context/*
!/docs/ai/generated/task-context/latest.md
!/docs/ai/generated/sessions/
/docs/ai/generated/sessions/*
!/docs/ai/generated/sessions/.gitkeep
/docs/generated/*
!/docs/generated/README.md

# Timestamped generated verification logs (kept for legacy compatibility)
/docs/ai/generated/logs/

# Optional installed packs; source lives under packages/ai-universal-rules/templates/optional/
.github/prompts-optional/
.opencode/agents-optional/

# Dotfiles migration — chezmoi private state
# Real personal data and chezmoi runtime state must never be committed.
home/.chezmoidata/personal.yaml
home/.chezmoidata/personal.local.yaml
home/.chezmoistate/

# Dotfiles migration — Nix build outputs
result
result-*

# Dotfiles migration — mise local overrides
mise.local.toml
.mise.local.toml

# Dotfiles migration — chezmoi snapshot-home outputs (local recovery only)
.dotfiles-snapshots/

