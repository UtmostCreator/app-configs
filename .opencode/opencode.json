        "bash scripts/generate-package-matrix.sh*": "allow",
        "bash scripts/snapshot-home.sh*": "allow",
        "bash scripts/validate-config.sh*": "allow",
        "bash scripts/detect-host.sh*": "allow",
        "bash scripts/bootstrap.sh --dry-run*": "allow",
        "bash scripts/bootstrap.sh -h": "allow",

        "bash tools/ai/*.sh *": "ask",
        "vendor/bin/phpunit *": "ask",
