      "docs/ai/generated/**": "ask",
      ".env": "ask",
      ".env.*": "ask",
      "*.pem": "ask",
      "*.key": "ask",
      "*.crt": "ask"
    },
    "grep": { "*": "ask" },
    "glob": { "*": "ask" },
    "list": { "*": "ask" },
      "bash": {
        "*": "ask",
        "git status*": "allow",
