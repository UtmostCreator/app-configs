        "php tools/ai/install-ai-kit.php *": "allow",
        "php tools/ai/validate-install-surface.php": "allow",
        "php tools/ai/verify-full-install.php": "allow",
        "php tools/ai/ai.php advisor --all": "allow",
        "grep *": "ask",
        "rg *": "ask",
        "find *": "ask",
        "fd *": "ask",
        "cat *": "ask",
        "sed *": "ask",
        "awk *": "ask",

        "rm *": "ask",
        "chown *": "ask",
        "sudo *": "ask",
        "git push*": "ask",
        "git add*": "allow",
        "git commit*": "allow",
        "git switch*": "allow",
        "git checkout*": "allow",
        "git restore*": "allow",
        "git mv*": "allow",
        "git rm*": "allow",
        "git stash*": "allow",
        "git tag*": "allow",
