// ~/Library/Application Support/Code/User/settings.json
{
  "search.exclude": {
    "**/.history/**": true,
    "**/.git": true,
    "**/node_modules": true,
    "**/vendor": true,
    "**/storage": true,
    "**/bootstrap/cache": true,
    "**/public/build": true,
    "**/database/snapshots": true,
    "**/public/static-frontend-images": true
  },
  "files.exclude": {
    "**/.history/**": true
  },
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 120,
  // =========================================================
  // GLOBAL: stable formatting strategy
  // =========================================================
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  // Prettier is the global formatter for "web" languages.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // Avoid accidental double-format by built-in formatters.
  "javascript.format.enable": false,
  "typescript.format.enable": false,
  // Team-safe: only format when repo config exists.
  "prettier.requireConfig": false,

  "prettier.useEditorConfig": false,
  "prettier.configPath": "",
  // =========================================================
  // FILES: reduce diff noise (safe defaults)
  // =========================================================
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  // =========================================================
  // Language associations (Laravel / Statamic)
  // =========================================================
  "files.associations": {
    "*.embeddedhtml": "html",
    "*.page-template": "vue",
    "*.layout-template": "vue",
    "*.vue": "vue",
    "*.blade.php": "blade",
    "*.antlers.html": "html",
    "*.antlers.php": "php",
    "*.env": "dotenv",
    ".env*": "dotenv",
    "*.stub": "php"
  },
  "emmet.includeLanguages": {
    "blade": "html",
    "vue": "html"
  },
  // =========================================================
  // PHP: Pint ONLY (DevSense = analysis only)
  // =========================================================
  "[php]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "open-southeners.laravel-pint",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },
  // Prevent duplicate diagnostics (VS Code PHP validator vs DevSense).
  "php.validate.enable": false,
  // Ensure Pint uses the project-local binary (not global).
  "laravel-pint.enable": true,
  "laravel-pint.executablePath": "./vendor/bin/pint",
  // (Optional) If you use Laravel Extra IntelliSense and want the right PHP runtime:
  // "laravelExtraIntellisense.phpCommand": "${env:HOME}/.config/herd/bin/php",
  // =========================================================
  // Blade: Blade Formatter ONLY
  // =========================================================
  "[blade]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {}
  },
  "bladeFormatter.format.enabled": true,
  "bladeFormatter.format.indentSize": 4,
  "bladeFormatter.format.wrapLineLength": 9999,
  "bladeFormatter.format.wrapAttributes": "preserve",
  "bladeFormatter.format.endWithNewline": true,
  "bladeFormatter.format.phpVersion": "8.3",
  "bladeFormatter.format.sortTailwindcssClasses": false,
  // =========================================================
  // JS / TS / Vue: Prettier formats, ESLint fixes
  // =========================================================
  "eslint.enable": true,
  "eslint.format.enable": false,
  "eslint.validate": ["javascript", "typescript", "javascriptreact", "typescriptreact", "vue"],
  "[javascript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[vue]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  // =========================================================
  // CSS / SCSS: Prettier formats, Stylelint fixes
  // =========================================================
  "stylelint.validate": ["css", "scss", "vue"],
  "[css]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "explicit"
    }
  },
  "[scss]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "explicit"
    }
  },
  // =========================================================
  // JSON / YAML / Markdown / HTML: Prettier only
  // =========================================================
  "json.format.enable": true,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": false
  },
  "yaml.format.singleQuote": true,
  "yaml.schemas": {
    "https://raw.githubusercontent.com/Konafets/statamic-blueprint-validation/main/statamic.blueprint.schema.json": [
      "resources/blueprints/**/*.yaml",
      "content/blueprints/**/*.yaml"
    ]
  },
  "[html]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // =========================================================
  // Tailwind (Blade/Vue)
  // =========================================================
  "tailwindCSS.includeLanguages": {
    "blade": "html",
    "vue": "html",
    "php": "html"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": []
  },
  "cSpell.enabled": false,
  "cSpell.ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/storage/**",
    "**/public/**",
    "**/.git/**"
  ],
  "cSpell.userWords": [],
  "editor.fontSize": 16,
  "terminal.integrated.fontSize": 16,
  "debug.console.fontSize": 16,
  "dotenv.enableAutocloaking": false,
  "search.searchView.keywordSuggestions": true,
  "github.copilot.chat.scopeSelection": true,
  "chat.checkpoints.showFileChanges": true,
  "github.copilot.chat.codesearch.enabled": true,
  "chat.editor.wordWrap": "on",
  "chat.useNestedAgentsMdFiles": true,
  "chat.commandCenter.enabled": true,
  "github.copilot.chat.useProjectTemplates": true,
  "chat.detectParticipant.enabled": true,
  "chat.checkpoints.enabled": true,
  "editor.inlineSuggest.edits.renderSideBySide": "auto",
  "editor.inlineSuggest.edits.allowCodeShifting": "always",
  "workbench.settings.showAISearchToggle": true,
  "github.copilot.enable": {
    "*": true,
    "markdown": false,
    "plaintext": false,
    "scminput": false
  },
  // =========================================================
  // Performance / stability
  // =========================================================
  "telemetry.telemetryLevel": "off",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/storage/**": true,
    "**/bootstrap/cache/**": true
  },
  // =========================================================
  // Linting on save (explicit = avoids random slowdowns)
  // =========================================================
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  // =========================================================
  // PHP IntelliSense: Intelephense ONLY
  // =========================================================
  "php.suggest.basic": false,
  "intelephense.telemetry.enabled": false,
  "intelephense.format.enable": false,
  "intelephense.files.maxSize": 5000000,
  // =========================================================
  // Laravel Extra IntelliSense
  // =========================================================
  "LaravelExtraIntellisense.basePath": "./",
  "LaravelExtraIntellisense.skipRunningComposerInstallOnProjectOpen": true,
  // =========================================================
  // Editor UX: navigation + readability
  // =========================================================
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  // This keeps Ctrl/Cmd+Click reserved for Go To Definition
  // (and uses Alt/Option+Click for multi-cursor)
  "editor.multiCursorModifier": "alt",
  "github.copilot.nextEditSuggestions.enabled": true,
  "editor.smoothScrolling": true,
  "sqltools.autoConnectTo": "",
  "editor.inlayHints.enabled": "off",
  "workbench.iconTheme": "material-icon-theme",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-5.1",
  "git.autofetch": true,
  "intelephense.files.exclude": ["**/.git/**", "**/.svn/**", "**/.hg/**", "**/node_modules/**"],
  "window.title": "${dirty}${activeEditorMedium}${separator}${rootName}",
  "sonarlint.connectedMode.connections.sonarcloud": [
    {
      "organizationKey": "YourOrganizationKey",
      "connectionId": "YourOrganizationKey",
      "region": "EU"
    }
  ],
  "workbench.tree.indent": 16,
  "sonarlint.automaticAnalysis": false,
  "docker.extension.enableComposeLanguageServer": false,
  "workbench.colorCustomizations": {
    // Peek view container
    "editor.peekView.border": "#3A3D41",
    "editor.peekViewTitle.background": "#1E1E1E",
    "editor.peekViewTitleLabel.foreground": "#D4D4D4",
    "editor.peekViewTitleDescription.foreground": "#9DA3A6",

    // Peek results list (left side)
    "editor.peekViewResult.background": "#121212",
    "editor.peekViewResult.lineForeground": "#B3B3B3",
    "editor.peekViewResult.fileForeground": "#E6E6E6",
    "editor.peekViewResult.selectionBackground": "#2B2B2B",
    "editor.peekViewResult.selectionForeground": "#FFFFFF",
    "editor.peekViewResult.matchHighlightBackground": "#5A3D00",

    // Peek editor (right side)
    "editor.peekViewEditor.background": "#0F0F0F",
    "editor.peekViewEditorGutter.background": "#0F0F0F",
    "editor.peekViewEditor.matchHighlightBackground": "#5A3D00"
  },
  "chat.agent.maxRequests": 75
}
