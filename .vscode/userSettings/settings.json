// ~/Library/Application Support/Code/User/settings.json
// ~/Library/Application Support/Code/User/settings.json
{
    // =========================================================
    // GENERAL EDITOR SETTINGS
    // =========================================================
    "editor.wordWrap": "bounded", // Bounded wrap respects wordWrapColumn
    "editor.wordWrapColumn": 120,
    "editor.rulers": [
        120
    ], // Visual guide at wrap column
    "editor.fontSize": 16,
    "editor.smoothScrolling": true,
    "editor.linkedEditing": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.indentation": true, // Show indentation guides
    "editor.guides.highlightActiveIndentation": true, // Highlight active scope
    "editor.guides.bracketPairsHorizontal": "active", // Show horizontal bracket guides
    "editor.renderWhitespace": "boundary", // Show whitespace at word boundaries
    "editor.renderControlCharacters": false,
    "editor.multiCursorModifier": "alt", // Alt/Option+Click for multi-cursor, Ctrl/Cmd+Click for Go To Definition
    "editor.codeLens": true,
    "editor.renderGutterDiff": true,
    "editor.inlayHints.enabled": "off",
    "editor.stickyScroll.enabled": true, // Keep function/class context visible while scrolling
    "editor.minimap.enabled": true,
    "editor.minimap.renderCharacters": false, // Faster rendering
    "editor.minimap.showSlider": "mouseover",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.suggest.preview": true,
    "editor.suggest.showStatusBar": true,
    "editor.suggestSelection": "recentlyUsedByPrefix", // Smarter suggestion ordering
    "editor.acceptSuggestionOnEnter": "smart", // Accept only when it makes sense
    "editor.tabSize": 2,
    "editor.detectIndentation": false, // Lock indentation (don't auto-detect from files)
    "editor.insertSpaces": true,
    "editor.acceptSuggestionOnCommitCharacter": true,
    "editor.snippetSuggestions": "top",
    "editor.parameterHints.enabled": true,
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
    },
    "editor.find.seedSearchStringFromSelection": "selection",
    "editor.tokenColorCustomizations": {
        "textMateRules": []
    },
    // Occurrence & selection highlighting (IDE-grade refactoring aids)
    "editor.selectionHighlight": true,
    "editor.occurrencesHighlight": "singleFile",
    "editor.wordHighlight": "on",
    "editor.renderLineHighlight": "all", // Highlight entire active line
    "editor.renderLineHighlightOnlyWhenFocus": true,
    "editor.cursorWidth": 2, // More visible cursor
    "editor.lineHeight": 24, // Better readability in dense templates
    "editor.fontLigatures": true, // Programming ligatures
    "editor.inlineSuggest.enabled": true, // Enable inline suggestions (Copilot)
    // Breadcrumbs for navigation
    "breadcrumbs.enabled": true,
    "breadcrumbs.filePath": "on",
    "breadcrumbs.symbolPath": "on",
    // =========================================================
    // GLOBAL FORMATTING STRATEGY
    // =========================================================
    // Prettier is the global formatter for "web" languages
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnSaveTimeout": 2000, // Prevent hanging on slow formatters
    "editor.formatOnPaste": false,
    "editor.formatOnType": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    // Avoid accidental double-format by built-in formatters
    "javascript.format.enable": false,
    "typescript.format.enable": false,
    "javascript.suggest.enabled": true,
    "javascript.validate.enable": true,
    // Prettier config (deterministic, repo-aware)
    "prettier.requireConfig": true, // Only format when repo has config
    "prettier.useEditorConfig": true, // Respect .editorconfig
    "prettier.prettierPath": "${workspaceFolder}/node_modules/prettier/index.cjs", // Prefer local Prettier (workspace-aware)
    // Global linting on save
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    // TypeScript: prefer workspace version
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    // =========================================================
    // FILES & SEARCH
    // =========================================================
    // Auto-save & file safety
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 5000, // 5s delay reduces format-on-save churn while still providing convenience
    "files.hotExit": "onExitAndWindowClose", // Preserve unsaved files
    // Reduce diff noise (safe defaults)
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    // File exclusions (improve Explorer performance)
    "files.exclude": {
        "**/.history/**": true,
        "**/node_modules/**": true,
        "**/vendor/**": true,
        "**/storage/**": true,
        "**/bootstrap/cache/**": true,
        "**/public/build/**": true
    },
    // Search exclusions (normalized patterns with /** for consistent folder exclusion)
    "search.exclude": {
        "**/.history/**": true,
        "**/.git/**": true,
        "**/node_modules/**": true,
        "**/vendor/**": true,
        "**/storage/**": true,
        "**/bootstrap/cache/**": true,
        "**/public/build/**": true,
        "**/database/snapshots/**": true,
        "**/public/static-frontend-images/**": true
    },
    "search.searchView.keywordSuggestions": true,
    "search.smartCase": true, // Smart case sensitivity
    "search.quickOpen.includeSymbols": false, // File-first Quick Open (use Ctrl+T for symbols)
    "search.collapseResults": "auto",
    "search.useIgnoreFiles": true,
    "search.followSymlinks": false,
    // Explorer (File tree) settings
    "explorer.confirmDelete": true, // Confirm before deleting files
    "explorer.confirmDragAndDrop": true, // Confirm before drag & drop
    "explorer.sortOrder": "type", // Group folders, then files
    "explorer.compactFolders": false, // Show each folder level separately for clarity
    "explorer.autoReveal": true, // Auto-reveal active file in explorer
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "explorer.openEditors.visible": 1, // Hide redundant Open Editors (tabs are source of truth)
    // File nesting (reduce noise for Laravel/Statamic)
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.php": "$(capture).blade.php, $(capture).test.php, $(capture).spec.php",
        "composer.json": "composer.lock",
        "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock",
        "vite.config.*": "vitest.config.*, tsconfig*.json",
        ".env": ".env.*, .env.example"
    },
    // Language associations (Laravel / Statamic)
    "files.associations": {
        "*.page-template": "vue",
        "*.layout-template": "vue",
        "*.vue": "vue",
        "*.embeddedhtml": "html",
        "*.blade.php": "blade",
        "*.antlers.html": "html",
        "*.antlers.php": "php",
        "*.env": "dotenv",
        ".env*": "dotenv",
        "*.php": "php",
        "*.stub": "php"
    },
    // Emmet support
    "emmet.includeLanguages": {
        "blade": "html",
        "vue": "html"
    },
    // =========================================================
    // LANGUAGE-SPECIFIC SETTINGS
    // =========================================================
    // --- PHP: Pint ONLY (Intelephense = analysis only) ---
    "[php]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "open-southeners.laravel-pint",
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {}
    },
    "php.validate.enable": false, // Disable built-in validation (Intelephense provides diagnostics)
    "php.suggest.basic": false, // Disable basic PHP suggestions (use Intelephense)
    // Laravel Pint configuration
    "laravel-pint.enable": true,
    "laravel-pint.executablePath": "./vendor/bin/pint",
    // --- Blade: Blade Formatter ONLY ---
    "[blade]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "shufo.vscode-blade-formatter",
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {}
    },
    "bladeFormatter.format.enabled": true,
    "bladeFormatter.format.indentSize": 4,
    "bladeFormatter.format.wrapLineLength": 9999,
    "bladeFormatter.format.wrapAttributes": "preserve",
    "bladeFormatter.format.endWithNewline": true,
    "bladeFormatter.format.phpVersion": "8.3",
    "bladeFormatter.format.sortTailwindcssClasses": false,
    // --- JavaScript: Prettier formats, ESLint fixes ---
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    // --- TypeScript: Prettier formats, ESLint fixes ---
    "[typescript]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    // --- JavaScript React: Prettier formats, ESLint fixes ---
    "[javascriptreact]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    // --- TypeScript React: Prettier formats, ESLint fixes ---
    "[typescriptreact]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    // --- Vue: Prettier formats, ESLint fixes ---
    "[vue]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit"
        }
    },
    // --- CSS: Prettier formats, Stylelint fixes ---
    "[css]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.stylelint": "explicit"
        }
    },
    // --- SCSS: Prettier formats, Stylelint fixes ---
    "[scss]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
            "source.fixAll.stylelint": "explicit"
        }
    },
    // --- JSON: Built-in formatter ---
    "json.format.enable": true,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true
    },
    // --- YAML: RedHat formatter ---
    "[yaml]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.formatOnSave": false
    },
    "yaml.format.singleQuote": true,
    "yaml.schemas": {
        "https://raw.githubusercontent.com/Konafets/statamic-blueprint-validation/main/statamic.blueprint.schema.json": [
            "resources/blueprints/**/*.yaml",
            "content/blueprints/**/*.yaml"
        ]
    },
    // --- HTML: Prettier formatter ---
    "[html]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    // --- Markdown: Prettier formatter ---
    "[markdown]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    // =========================================================
    // LINTERS & CODE QUALITY TOOLS
    // =========================================================
    // ESLint configuration
    "eslint.enable": true,
    "eslint.format.enable": false,
    "eslint.useFlatConfig": true,
    "eslint.run": "onSave", // Run ESLint on save
    "eslint.workingDirectories": [
        {
            "mode": "auto"
        }
    ], // Monorepo support
    "eslint.validate": [
        "javascript",
        "typescript",
        "javascriptreact",
        "typescriptreact",
        "vue"
    ],
    // Stylelint configuration
    "stylelint.validate": [
        "css",
        "scss",
        "vue"
    ],
    // Intelephense (PHP IntelliSense)
    "intelephense.telemetry.enabled": false,
    "intelephense.format.enable": false,
    "intelephense.files.maxSize": 5000000,
    "intelephense.files.exclude": [
        "**/.git/**",
        "**/.svn/**",
        "**/.hg/**",
        "**/node_modules/**",
        "**/vendor/*/test/**",
        "**/vendor/*/tests/**",
        "**/vendor/*/*/test/**",
        "**/vendor/*/*/tests/**"
    ],
    "intelephense.completion.triggerParameterHints": true,
    "intelephense.completion.insertUseDeclaration": true,
    "intelephense.completion.fullyQualifyGlobalConstantsAndFunctions": false,
    "intelephense.stubs": [
        "apache",
        "bcmath",
        "bz2",
        "calendar",
        "com_dotnet",
        "Core",
        "ctype",
        "curl",
        "date",
        "dba",
        "dom",
        "enchant",
        "exif",
        "fileinfo",
        "filter",
        "fpm",
        "ftp",
        "gd",
        "hash",
        "iconv",
        "imap",
        "interbase",
        "intl",
        "json",
        "ldap",
        "libxml",
        "mbstring",
        "mcrypt",
        "meta",
        "mysqli",
        "oci8",
        "odbc",
        "openssl",
        "pcntl",
        "pcre",
        "PDO",
        "pdo_ibm",
        "pdo_mysql",
        "pdo_pgsql",
        "pdo_sqlite",
        "pgsql",
        "Phar",
        "posix",
        "pspell",
        "readline",
        "recode",
        "Reflection",
        "regex",
        "session",
        "shmop",
        "SimpleXML",
        "snmp",
        "soap",
        "sockets",
        "sodium",
        "SPL",
        "sqlite3",
        "standard",
        "superglobals",
        "sybase",
        "sysvmsg",
        "sysvsem",
        "sysvshm",
        "tidy",
        "tokenizer",
        "wddx",
        "xml",
        "xmlreader",
        "xmlrpc",
        "xmlwriter",
        "Zend OPcache",
        "zip",
        "zlib"
    ],
    // Laravel-specific: Suppress false positives while keeping real error detection
    "intelephense.diagnostics.undefinedFunctions": false, // Laravel helpers (data_get, config, etc.)
    "intelephense.diagnostics.undefinedTypes": false, // Carbon, Collection, etc.
    "intelephense.diagnostics.undefinedMethods": false, // Eloquent magic methods, facades
    "intelephense.diagnostics.undefinedProperties": false, // Eloquent magic properties
    "intelephense.diagnostics.undefinedClassConstants": true, // Keep this enabled for real errors
    "intelephense.diagnostics.undefinedConstants": true, // Keep this enabled for real errors
    // SonarLint
    "sonarlint.automaticAnalysis": false,
    "sonarlint.connectedMode.connections.sonarcloud": [
        {
            "organizationKey": "rabbies-trail-burners",
            "connectionId": "rabbies-trail-burners",
            "region": "EU"
        }
    ],
    // Spell checker (disabled)
    "cSpell.enabled": false,
    "cSpell.ignorePaths": [
        "**/vendor/**",
        "**/node_modules/**",
        "**/storage/**",
        "**/public/**",
        "**/.git/**"
    ],
    "cSpell.userWords": [],
    // =========================================================
    // FRAMEWORK & TOOLS
    // =========================================================
    // Laravel Extra IntelliSense
    "LaravelExtraIntellisense.basePath": "./",
    "LaravelExtraIntellisense.skipRunningComposerInstallOnProjectOpen": true,
    // Tailwind CSS
    "tailwindCSS.includeLanguages": {
        "blade": "html",
        "vue": "html",
        "php": "html"
    },
    // Dotenv
    "dotenv.enableAutocloaking": false,
    // SQL Tools
    "sqltools.autoConnectTo": "",
    // Docker
    "docker.extension.enableComposeLanguageServer": false,
    // =========================================================
    // GITHUB COPILOT & AI
    // =========================================================
    "github.copilot.enable": {
        "*": true,
        "markdown": false,
        "plaintext": false,
        "scminput": false
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.chat.scopeSelection": true,
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.chat.useProjectTemplates": true,
    // Chat/AI settings
    "chat.checkpoints.enabled": true,
    "chat.checkpoints.showFileChanges": true,
    "chat.editor.wordWrap": "on",
    "chat.useNestedAgentsMdFiles": true,
    "chat.commandCenter.enabled": true,
    "chat.detectParticipant.enabled": true,
    "chat.agent.maxRequests": 75,
    // AI-assisted editing
    "editor.inlineSuggest.edits.renderSideBySide": "auto",
    "editor.inlineSuggest.edits.allowCodeShifting": "always",
    "workbench.settings.showAISearchToggle": true,
    // GitLens AI
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-5.1",
    // =========================================================
    // GIT & VERSION CONTROL
    // =========================================================
    "git.autofetch": true,
    "git.mergeEditor": true,
    "git.openRepositoryInParentFolders": "never",
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "git.untrackedChanges": "separate", // Show untracked changes separately
    "git.decorations.enabled": true,
    "git.enableStatusBarSync": true,
    "git.suggestSmartCommit": false,
    "git.pruneOnFetch": true,
    "git.fetchOnPull": true,
    "git.rebaseWhenSync": false,
    // Diff editor settings
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": true,
    "diffEditor.wordWrap": "on", // Better for code review
    // SCM (Source Control Management)
    "scm.defaultViewMode": "tree", // Tree view for better organization
    "scm.diffDecorations": "all",
    "scm.alwaysShowActions": true,
    // =========================================================
    // PERFORMANCE & STABILITY
    // =========================================================
    "telemetry.telemetryLevel": "off",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/vendor/**": true,
        "**/storage/**": true,
        "**/bootstrap/cache/**": true
    },
    // =========================================================
    // WORKBENCH (IDE Behavior)
    // =========================================================
    "workbench.editor.enablePreview": false, // Always pin files (no preview mode)
    "workbench.editor.enablePreviewFromQuickOpen": false, // Quick open always pins
    "workbench.editor.revealIfOpen": true, // Focus existing tab instead of opening duplicate
    "workbench.editor.closeOnFileDelete": true,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.tabCloseButton": "right",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.wrapTabs": false,
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.labelFormat": "medium", // Show path context in tabs
    "workbench.editor.decorations.badges": true,
    "workbench.editor.decorations.colors": true,
    // Tab limits (prevent tab explosion - highest ROI sanity setting)
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 12, // Keep max 12 tabs per group
    "workbench.editor.limit.perEditorGroup": true,
    "workbench.editor.limit.excludeDirty": true, // Don't close unsaved files
    "workbench.startupEditor": "welcomePageInEmptyWorkbench", // Clean startup
    "workbench.list.smoothScrolling": true,
    "workbench.list.openMode": "doubleClick",
    "workbench.commandPalette.history": 50,
    "workbench.quickOpen.closeOnFocusLost": true,
    "workbench.sideBar.location": "left",
    "workbench.panel.defaultLocation": "bottom", // Keep terminal/output at bottom
    "workbench.statusBar.visible": true,
    "workbench.tips.enabled": false, // Reduce noise
    // =========================================================
    // TERMINAL
    // =========================================================
    "terminal.integrated.fontSize": 16,
    "terminal.integrated.fontFamily": "MesloLGS NF, Menlo, Monaco, 'Courier New', monospace",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.enableMultiLinePasteWarning": "auto", // Safety for multi-line pastes
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.persistentSessionReviveProcess": "onExit",
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.env.osx": {},
    // =========================================================
    // PROBLEMS & DIAGNOSTICS
    // =========================================================
    "problems.decorations.enabled": true, // Show errors in file explorer
    "problems.showCurrentInStatus": true, // Show current file problems in status bar
    "problems.sortOrder": "severity",
    "problems.autoReveal": true,
    // =========================================================
    // SECURITY & WORKSPACE TRUST
    // =========================================================
    "security.workspace.trust.enabled": true,
    "security.workspace.trust.startupPrompt": "once",
    "security.workspace.trust.untrustedFiles": "prompt",
    "security.workspace.trust.emptyWindow": true,
    // =========================================================
    // UI/UX & APPEARANCE
    // =========================================================
    "workbench.colorTheme": "Default Dark+",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.tree.indent": 16,
    "window.title": "${dirty}${activeEditorMedium}${separator}${rootName}",
    "window.restoreWindows": "all", // Restore all windows on restart
    "window.newWindowDimensions": "inherit",
    "window.zoomLevel": 0,
    // Font sizes
    "debug.console.fontSize": 16,
    // Peek view customization
    "workbench.colorCustomizations": {
        // Peek view container
        "editor.peekView.border": "#3A3D41",
        "editor.peekViewTitle.background": "#1E1E1E",
        "editor.peekViewTitleLabel.foreground": "#D4D4D4",
        "editor.peekViewTitleDescription.foreground": "#9DA3A6",
        // Peek results list (left side)
        "editor.peekViewResult.background": "#121212",
        "editor.peekViewResult.lineForeground": "#B3B3B3",
        "editor.peekViewResult.fileForeground": "#E6E6E6",
        "editor.peekViewResult.selectionBackground": "#2B2B2B",
        "editor.peekViewResult.selectionForeground": "#FFFFFF",
        "editor.peekViewResult.matchHighlightBackground": "#5A3D00",
        // Peek editor (right side)
        "editor.peekViewEditor.background": "#0F0F0F",
        "editor.peekViewEditorGutter.background": "#0F0F0F",
        "editor.peekViewEditor.matchHighlightBackground": "#5A3D00"
    },
    // =========================================================
    // DEBUG
    // =========================================================
    "debug.inlineValues": "auto",
    "debug.toolBarLocation": "docked",
    "debug.showBreakpointsInOverviewRuler": true,
    "debug.showInlineBreakpointCandidates": true,
    "debug.openDebug": "openOnDebugBreak",
    // =========================================================
    // EXTENSION-SPECIFIC ENHANCEMENTS
    // =========================================================
    // Path IntelliSense
    "path-intellisense.autoSlashAfterDirectory": true,
    "path-intellisense.extensionOnImport": false,
    // Error Lens (if installed)
    "errorLens.enabled": true,
    "errorLens.enabledDiagnosticLevels": [
        "error",
        "warning"
    ],
    "errorLens.fontSize": "0.9em",
    // GitLens enhancements
    "gitlens.codeLens.enabled": true,
    "gitlens.codeLens.authors.enabled": false, // Reduce noise
    "gitlens.codeLens.recentChange.enabled": true,
    "gitlens.currentLine.enabled": true,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.statusBar.enabled": true,
    "gitlens.views.branches.branches.layout": "tree",
    "gitlens.views.commits.files.layout": "tree",
    // Bookmarks (if installed)
    "bookmarks.saveBookmarksInProject": true,
    "bookmarks.navigateThroughAllFiles": true,
    // TODO Tree (if installed)
    "todo-tree.general.tags": [
        "TODO",
        "FIXME",
        "BUG",
        "HACK",
        "NOTE",
        "XXX"
    ],
    "todo-tree.highlights.defaultHighlight": {
        "icon": "alert",
        "type": "text",
        "foreground": "#fff",
        "background": "#ffbd2e",
        "opacity": 50,
        "iconColour": "#ffbd2e"
    },
