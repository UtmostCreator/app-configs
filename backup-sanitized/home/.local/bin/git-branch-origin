#!/usr/bin/env bash
set -euo pipefail

branch="${1:-$(git branch --show-current)}"

if [[ -z "$branch" ]]; then
  echo "Unknown: no branch provided and not currently on a branch" >&2
  exit 1
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Unknown: not inside a Git repository" >&2
  exit 1
fi

# Get the oldest reflog entry saying the branch was created.
# Reflog is usually newest-first, so keep the last matching creation entry.
creation_record="$(
  git reflog show --format='%H%x09%gs' "$branch" 2>/dev/null \
    | awk -F '\t' '$2 ~ /^branch: Created from / { record = $0 } END { print record }'
)"

if [[ -z "$creation_record" ]]; then
  echo "Unknown: branch creation entry not found in reflog" >&2
  exit 1
fi

base_commit="${creation_record%%$'\t'*}"
creation_subject="${creation_record#*$'\t'}"
created_from="${creation_subject#branch: Created from }"

# If Git recorded an explicit source branch/ref, prefer that.
# Example: "branch: Created from main"
# But avoid returning HEAD, commit hashes, or non-branch-ish values blindly.
if [[ "$created_from" != "HEAD" ]] && [[ ! "$created_from" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
  if git rev-parse --verify --quiet "$created_from^{commit}" >/dev/null; then
    short_name="$created_from"

    # Normalise common remote refs like origin/main -> main.
    if [[ "$short_name" == */* ]]; then
      remote="${short_name%%/*}"
      rest="${short_name#*/}"

      if git remote | grep -Fxq "$remote"; then
        short_name="$rest"
      fi
    fi

    if [[ "$short_name" != "$branch" ]]; then
      echo "$short_name"
      exit 0
    fi
  fi
fi

# Collect branches that contain the base commit.
# Use git for-each-ref instead of parsing git branch -a output.
mapfile -t refs < <(
  git for-each-ref \
    --contains "$base_commit" \
    --format='%(refname:short)' \
    refs/heads refs/remotes \
  | grep -vE '(^|/)HEAD$' \
  | sort -u
)

if [[ "${#refs[@]}" -eq 0 ]]; then
  echo "Unknown: no containing branch found for $base_commit" >&2
  exit 1
fi

normalise_ref() {
  local ref="$1"

  # Strip remote prefix only if the first path segment is a real remote.
  if [[ "$ref" == */* ]]; then
    local first="${ref%%/*}"
    local rest="${ref#*/}"

    if git remote | grep -Fxq "$first"; then
      printf '%s\n' "$rest"
      return
    fi
  fi

  printf '%s\n' "$ref"
}

# Build unique normalised candidates, excluding the target branch.
candidates=()

for ref in "${refs[@]}"; do
  name="$(normalise_ref "$ref")"

  if [[ "$name" == "$branch" ]]; then
    continue
  fi

  already_seen=false

  for existing in "${candidates[@]}"; do
    if [[ "$existing" == "$name" ]]; then
      already_seen=true
      break
    fi
  done

  if [[ "$already_seen" == false ]]; then
    candidates+=("$name")
  fi
done

if [[ "${#candidates[@]}" -eq 0 ]]; then
  echo "Unknown: no candidate branch found for $base_commit" >&2
  exit 1
fi

# Prefer the repository default branch if it contains the base commit.
default_remote_ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"

if [[ -n "$default_remote_ref" ]]; then
  default_branch="$(normalise_ref "$default_remote_ref")"

  for candidate in "${candidates[@]}"; do
    if [[ "$candidate" == "$default_branch" ]]; then
      echo "$candidate"
      exit 0
    fi
  done
fi

# Prefer common long-lived branch names.
preferred_patterns=(
  main
  master
  develop
  development
  dev
  staging
  stage
  release
  release/*
  hotfix
  hotfix/*
  support
  support/*
)

for pattern in "${preferred_patterns[@]}"; do
  for candidate in "${candidates[@]}"; do
    case "$candidate" in
      $pattern)
        echo "$candidate"
        exit 0
        ;;
    esac
  done
done

# Fallback: return the first candidate.
printf '%s\n' "${candidates[0]}"
