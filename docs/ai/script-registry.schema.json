{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-configs.local/docs/ai/script-registry.schema.json",
  "title": "AI Script Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["scripts"],
  "properties": {
    "risk_tiers": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "scripts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "source_path",
          "installed_path",
          "pack",
          "required_tools",
          "risk",
          "supports_dry_run",
          "default_args"
        ],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "pattern": "^scripts/ai/.+\\.sh$" },
          "installed_path": { "type": "string", "pattern": "^scripts/ai/.+\\.sh$" },
          "pack": { "type": "string", "minLength": 1 },
          "required_tools": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "risk": { "type": "string", "enum": ["read-only", "mutating"] },
          "supports_dry_run": { "type": "boolean" },
          "default_args": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tier": {
            "type": "string",
            "enum": ["tier0", "tier1", "tier2", "tier3", "tier4"]
          },
          "mutates_state": { "type": "boolean" },
          "writes_paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reads_secret_values": { "type": "boolean" },
          "supports_json": { "type": "boolean" },
          "bounded_output": { "type": "boolean" },
          "requires_approval": { "type": "boolean" },
          "command": { "type": "string", "minLength": 1 },
          "metadata_status": { "type": "string", "enum": ["complete", "partial"] },
          "interface": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "usage": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "modes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "options": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "allowed_agents": {
            "type": "array",
            "items": { "type": "string" }
          },
          "safe_subcommands": {
            "type": "array",
            "items": { "type": "string" }
          },
          "blocked_subcommands": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
