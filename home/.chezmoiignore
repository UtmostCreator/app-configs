# from that into ~/.config/projects/config.yaml.
projects.yaml.example

# opencode writes runtime/plugin junk next to its config (node_modules,
# package.json, lockfiles, .bak backups). We ship only opencode.jsonc; never
# manage or clobber the generated files.
.config/opencode/node_modules
.config/opencode/node_modules/**
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/bun.lock
.config/opencode/.gitignore
.config/opencode/*.bak-*

{{- $hostProfile := default "linux-desktop" .hostProfile -}}
{{- $gui := default false .gui -}}

{{- /*
  macInput group (T-0042): whether the macOS input configs are deployed.
  Host default profile: linux-desktop is "personal", every other host "work"
  (kept equal to myConfig.profile by tests/bash/chezmoiignore-selection.bats).
  Only darwin reads the selection, so an unreadable file cannot affect Linux.
  macInput resolves from, in order:
    1. [groups] macInput (a boolean) in the local selection file,
       ${APP_CONFIGS_SELECTION_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/app-configs/selection}/selection.toml
    2. the same key in nix/profiles/<profile>.toml next to this source tree,
       where <profile> is the local file's `profile`, else the host default
    3. true (the committed default, every group on)
  A missing or empty local file, a missing key, a value that is not a boolean
  and a profile name that is not a profile file all fall through. A file that
  is not valid TOML fails the render on darwin; install.sh and the Nix build
  reject such a file first.
*/ -}}
{{- $profiles := list "work" "personal" -}}
{{- $hostDefault := "work" -}}
{{- if eq $hostProfile "linux-desktop" -}}{{- $hostDefault = "personal" -}}{{- end -}}
{{- $macInput := false -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $macInput = true -}}
{{-   $selDir := env "APP_CONFIGS_SELECTION_DIR" -}}
{{-   if not $selDir -}}
{{-     $xdg := env "XDG_CONFIG_HOME" -}}
{{-     if not $xdg -}}{{- $xdg = printf "%s/.config" (or (env "HOME") .chezmoi.homeDir) -}}{{- end -}}
{{-     $selDir = printf "%s/app-configs/selection" $xdg -}}
{{-   end -}}
{{-   $local := dict -}}
{{-   $selFile := printf "%s/selection.toml" $selDir -}}
{{-   if stat $selFile -}}{{- $local = include $selFile | fromToml -}}{{- end -}}
{{-   $profile := $hostDefault -}}
{{-   if has (get $local "profile") $profiles -}}{{- $profile = get $local "profile" -}}{{- end -}}
{{-   $profileFile := printf "%s/../nix/profiles/%s.toml" .chezmoi.sourceDir $profile -}}
{{-   if stat $profileFile -}}
{{-     $fromProfile := dig "groups" "macInput" "unset" (include $profileFile | fromToml) -}}
{{-     if kindIs "bool" $fromProfile -}}{{- $macInput = $fromProfile -}}{{- end -}}
{{-   end -}}
{{-   $fromLocal := dig "groups" "macInput" "unset" $local -}}
{{-   if kindIs "bool" $fromLocal -}}{{- $macInput = $fromLocal -}}{{- end -}}
{{- end }}
# host default profile: {{ $hostDefault }}
# known profiles: {{ join " " $profiles }}

{{- /*
  .chezmoiignore patterns match against TARGET (destination) paths
  rooted at $HOME, not against source-tree names like dot_config/...
  Use ~/.config/<dir> form (without the literal "~/"), i.e. ".config/<dir>"
  and "Library/...".
*/ -}}

{{- if ne .chezmoi.os "darwin" }}
# macOS-only paths excluded on Linux/WSL.
Library
Library/**
.config/karabiner
.config/karabiner/**
# On Linux, Home Manager owns flameshot.ini (nix/modules/home/gui.nix: tray +
# resident daemon for Wayland hotkeys); the chezmoi copy is for macOS only.
.config/flameshot
.config/flameshot/**
# Colima is macOS-only (nix/modules/home/dev.nix); Linux and WSL2 use a native
# or host Docker daemon (T-0038).
.colima
.colima/**
# macOS has no cgroups; Linux gets its memory caps from systemd (gui.nix).
.local/bin/terminal-memory-guard
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
.config/niri
.config/niri/**
# Linux VS Code path excluded on macOS.
.config/Code
.config/Code/**
# Linux/WSL Ghostty XDG path excluded on macOS (macOS uses the
# Library/Application Support/com.mitchellh.ghostty path instead).
.config/ghostty
.config/ghostty/**
{{- end }}

{{- if not $macInput }}
# macInput off, or not darwin: the macOS input configs (Karabiner-Elements,
# LinearMouse) are not deployed.
.config/karabiner
.config/karabiner/**
.config/linearmouse
.config/linearmouse/**
{{- end }}

{{- if eq $hostProfile "wsl" }}
# WSL2: VS Code is the Windows app + Remote-WSL. Windows VS Code reads its
# user settings from %APPDATA%\Code\User (synced via Settings Sync) and the
# WSL server reads ~/.vscode-server/data/Machine/settings.json, so nothing
# ever reads ~/.config/Code here.
.config/Code
.config/Code/**
{{- end }}

{{- if or (eq $hostProfile "wsl") (eq $hostProfile "linux-cli") }}
.config/niri
.config/niri/**
# WSL and linux-cli: no Ghostty (no GUI terminal).
.config/ghostty
.config/ghostty/**
Library/Application Support/com.mitchellh.ghostty
Library/Application Support/com.mitchellh.ghostty/**
{{- end }}

{{- if not $gui }}
.config/niri
.config/niri/**
# Headless / gui=false: belt-and-braces drop ghostty + karabiner.
.config/ghostty
.config/ghostty/**
Library/Application Support/com.mitchellh.ghostty
Library/Application Support/com.mitchellh.ghostty/**
.config/karabiner
.config/karabiner/**
{{- end }}
