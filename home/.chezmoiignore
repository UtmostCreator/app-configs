# personal.yaml.example is documentation, not a dotfile to deploy.
# The real file is home/.chezmoidata/personal.yaml (gitignored).
personal.yaml.example

# projects.yaml.example same — template only, never deployed to $HOME.
# Real per-host config lives in home/.chezmoidata/projects.yaml
# (gitignored). chezmoi renders home/dot_config/projects/config.yaml.tmpl
# from that into ~/.config/projects/config.yaml.
projects.yaml.example

{{- $hostProfile := default "linux-desktop" .hostProfile -}}
{{- $gui := default false .gui -}}

{{- /*
  .chezmoiignore patterns match against TARGET (destination) paths
  rooted at $HOME, not against source-tree names like dot_config/...
  Use ~/.config/<dir> form (without the literal "~/"), i.e. ".config/<dir>"
  and "Library/...".
*/ -}}

{{- if ne .chezmoi.os "darwin" }}
# macOS-only paths excluded on Linux/WSL.
Library
Library/**
.config/karabiner
.config/karabiner/**
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# Linux/WSL VS Code path excluded on macOS.
.config/Code
.config/Code/**
# Linux/WSL Ghostty XDG path excluded on macOS (macOS uses the
# Library/Application Support/com.mitchellh.ghostty path instead).
.config/ghostty
.config/ghostty/**
{{- end }}

{{- if or (eq $hostProfile "wsl") (eq $hostProfile "linux-cli") }}
# WSL and linux-cli: no Ghostty (no GUI terminal).
.config/ghostty
.config/ghostty/**
Library/Application Support/com.mitchellh.ghostty
Library/Application Support/com.mitchellh.ghostty/**
{{- end }}

{{- if not $gui }}
# Headless / gui=false: belt-and-braces drop ghostty + karabiner.
.config/ghostty
.config/ghostty/**
Library/Application Support/com.mitchellh.ghostty
Library/Application Support/com.mitchellh.ghostty/**
.config/karabiner
.config/karabiner/**
{{- end }}
