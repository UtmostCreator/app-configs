{
  "servers": {
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "{{ lookPath "codebase-memory-mcp" | default "codebase-memory-mcp" }}",
      "args": []
    },
    "io.github.ChromeDevTools/chrome-devtools-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "chrome-devtools-mcp@1.12.0",
        "--isolated",
        "--usageStatistics=false",
        "--performanceCrux=false",
        "--redactNetworkHeaders=true"
      ]
    }
  },
  "inputs": []
}
