{{- /*
  Fish functions for the whole-stack maintenance scripts. These manage
  installed APPLICATIONS + CLI tools + dotfiles + system store, not just
  dotfiles. chezmoi renders {{ .chezmoi.sourceDir }} to the repo path at apply
  time, so they work from any directory.

  Auto-sourced by fish (conf.d). Provides:
    sys-update    -> update all apps/CLI/dotfiles + safe cleanup (brewup)
    sys-cleanup   -> de-dup store + prune caches (keeps rollbacks)
    sys-cleanup-gc-> + remove aged generations (keeps recent)
    sys-install   -> re-run unattended full install
    sys-doctor    -> health check
    syscd         -> cd into the repo
*/ -}}
# Resolve the repo. chezmoi source is <repo>/home, so strip /home.
set -gx DOTFILES_DIR {{ .chezmoi.sourceDir | trimSuffix "/home" }}

function syscd --description 'cd into the dotfiles/system repo'
    cd "$DOTFILES_DIR"
end

function sys-install --description 'Re-run the unattended full install (apps + config)'
    bash "$DOTFILES_DIR/scripts/install.sh" $argv
end

function sys-update --description 'Update all installed apps/CLI + config (brewup equivalent)'
    bash "$DOTFILES_DIR/scripts/update-all.sh" --apply $argv
end

function sys-cleanup --description 'Safe cleanup of app store + caches (keeps all rollbacks)'
    bash "$DOTFILES_DIR/scripts/cleanup.sh" --apply $argv
end

function sys-cleanup-gc --description 'Cleanup + remove aged generations (keeps recent)'
    bash "$DOTFILES_DIR/scripts/cleanup.sh" --apply --gc $argv
end

function sys-doctor --description 'Run the system/dotfiles health check'
    bash "$DOTFILES_DIR/scripts/doctor.sh" $argv
end

function sys-readiness --description 'Am I all set? Verify install + report whats left'
    bash "$DOTFILES_DIR/scripts/readiness.sh" $argv
end

function sys-setup --description 'NixOS system layer setup (fish shell + gc); add --apply with sudo'
    bash "$DOTFILES_DIR/scripts/system-setup.sh" $argv
end
