{{- /*
  Fish shell config, ported from home/dot_zshrc.tmpl.

  Fish ships autosuggestions (history + completion) and syntax highlighting
  BUILT IN, so we intentionally do NOT install zsh-autosuggestions /
  zsh-syntax-highlighting equivalents. Atuin replaces fish history search.

  Parity notes vs. dot_zshrc.tmpl:
    - brewup        -> replaced by `sys-update` (Nix-native, see conf.d/dotfiles.fish).
    - zsh ZLE/bindkey/atuin-widget blocks -> handled by `atuin init fish`.
    - LISTMAX / Oh My Zsh / p10k         -> zsh-only, no fish equivalent.

  This is a chezmoi template: macOS-only blocks are gated on
  {{ .chezmoi.os }}. conf.d/*.fish (e.g. ssh-agent.fish) is auto-sourced by
  fish and is NOT duplicated here.
*/ -}}

# ─── Interactive guard ──────────────────────────────────────────────────────
# Most of this only matters for interactive shells; keep non-interactive
# (scripts, scp) startup fast and side-effect free.
if not status is-interactive
    # Still ensure user bins are on PATH for non-interactive tools.
    fish_add_path -g $HOME/.local/bin
    exit 0
end

# ─── Greeting ───────────────────────────────────────────────────────────────
# Empty greeting: no "Welcome to fish" banner on every new terminal. Nothing
# else owns this (programs.fish is not enabled in nix/).
set -g fish_greeting

# ─── PATH ───────────────────────────────────────────────────────────────────
# fish_add_path is idempotent and prepends in front of the system path.
fish_add_path -g $HOME/.local/bin

# ─── Environment flags ──────────────────────────────────────────────────────
# Copilot CLI: enforce repo hook allowlists when available.
set -gx COPILOT_STRICT_ALLOWLIST 1
# Atuin: keep history search inline (no tmux popup).
set -gx ATUIN_TMUX_POPUP false
# GPG: tell gpg/ssh which terminal to prompt on (pinentry-curses, gpg-agent).
set -gx GPG_TTY (tty)

# ─── Editing mode ────────────────────────────────────────────────────────────
# Vi keybindings (borrowed from nix-config review). NOTE: Atuin owns Ctrl-R and
# fzf owns Ctrl-T/Alt-C below; vi mode coexists with those widget bindings.
fish_vi_key_bindings

# Emacs-style line jumps on top of vi mode. fish_vi_key_bindings does NOT bind
# Ctrl-A / Ctrl-E (those are Emacs-mode defaults), so in vi mode Ctrl-A did
# nothing — unlike Emacs-style line editors (e.g. opencode) where Ctrl-A jumps
# to the start of the line. Re-add the muscle-memory shortcuts in every vi bind
# mode (default/insert/visual) so they work regardless of the current mode:
#   Ctrl-A -> beginning of line, Ctrl-E -> end of line.
for mode in default insert visual
    bind -M $mode \cA beginning-of-line
    bind -M $mode \cE end-of-line
end

# Tab always completes: it lists the folders and files in the current
# directory (and workspace folders via CDPATH below). It used to accept the
# grey history suggestion first, so `cd p<Tab>` jumped to an old path instead
# of offering the folders here. Accept a suggestion with Right, End, Ctrl-F
# or vi's Ctrl-N. `forward-char-passive` would not accept ghost text, so
# Right uses the accepting motion.
bind -M insert tab complete
bind -M insert right forward-char
bind -M insert end accept-autosuggestion or end-of-line
bind -M insert ctrl-f accept-autosuggestion

# `cd <Tab>` also offers the folders under ~/Projects from anywhere (zoxide
# `z` still jumps by frecency). Global, never exported: an exported CDPATH
# makes bash's cd print paths, which breaks `$(cd dir && pwd)` in scripts.
set -g CDPATH . $HOME/Projects

# ─── Tool integrations (init order matters) ─────────────────────────────────
# Starship prompt — single config shared with zsh/bash.
set -gx STARSHIP_CONFIG "$HOME/.config/starship/starship.toml"
if type -q starship
    starship init fish | source
end

# zoxide (smarter cd).
if type -q zoxide
    zoxide init fish | source
end

# fzf key bindings — Atuin owns Ctrl-R below; fzf still provides Ctrl-T / Alt-C.
if type -q fzf
    fzf --fish | source
end

# Atuin: searchable shell history (owns Ctrl-R / Up). Fish autosuggestions
# stay enabled; Atuin replaces the history *search* UI.
if type -q atuin
    atuin init fish | source
end

# mise (runtime/task manager). On NixOS, runtimes such as node are provided by
# Nix (see nix/modules/home/dev.nix) and mise must not compile them. mise still
# activates here for per-project tasks/tool shims that Nix does not supply.
if type -q mise
    mise activate fish | source
end

# ─── Functions ──────────────────────────────────────────────────────────────
# Navigation: yazi wrapper that cd's to the directory yazi exits in.
function yy --description 'yazi, then cd to its exit directory'
    set -l tmp (mktemp -t "yazi-cwd.XXXXXX")
    yazi $argv --cwd-file="$tmp"
    if set -l cwd (command cat -- "$tmp"); and test -n "$cwd"; and test "$cwd" != "$PWD"
        builtin cd -- "$cwd"
    end
    rm -f -- "$tmp"
end

# Search: ripgrep that skips data/dumps/storage (from zshrc rggi).
function rggi --description 'ripgrep excluding sql/dump/seed/database/storage'
    rg --glob '!*.sql' --glob '!*.dump' --glob '!*.seed.*' \
       --glob '!database/**' --glob '!storage/**' $argv
end

# Dev: run a filtered Laravel test suite (from zshrc atest).
function atest --description 'php artisan test --filter=<arg>'
    php artisan test --filter=$argv[1]
end

{{ if eq .chezmoi.os "darwin" -}}
# ─── macOS only ──────────────────────────────────────────────────────────────
# Herd PHP + Homebrew mysql-client on PATH (ported from zshrc).
fish_add_path -g "$HOME/Library/Application Support/Herd/bin"
fish_add_path -g /Applications/Herd.app/Contents/MacOS
fish_add_path -g /opt/homebrew/opt/mysql-client/bin
set -gx HERD_PHP_84_INI_SCAN_DIR "$HOME/Library/Application Support/Herd/config/php/84/"
set -gx HERD_PHP_83_INI_SCAN_DIR "$HOME/Library/Application Support/Herd/config/php/83/"
set -gx NODE_EXTRA_CA_CERTS "$HOME/Library/Application Support/Herd/config/valet/CA/LaravelValetCASelfSigned.pem"
{{ end -}}

{{ if ne .chezmoi.os "darwin" -}}
# ─── WSL2: open URLs and files with Windows ─────────────────────────────────
# wsl-open (~/.local/bin) replaces macOS `open` and the removed wslview, so
# gh auth login / gh browse / `open .` reach the Windows default app.
if set -q WSL_DISTRO_NAME; or set -q WSL_INTEROP
    set -gx BROWSER wsl-open
    function open --description 'open a URL, file or folder with Windows (wsl-open)'
        wsl-open $argv
    end
end
{{ end -}}

# ─── 1Password-backed integrations (macOS and Linux/WSL2) ───────────────────
# `op` comes from the Homebrew cask on macOS and from Nix on Linux (dev.nix).
# NPM token: load only when already signed in (no startup prompt).
if type -q op; and op whoami >/dev/null 2>&1
    set -gx NPM_TOKEN (op item get 'GitHub NPM Token' --fields label=token --reveal 2>/dev/null)
end

# composer wrapper: inject GitHub OAuth from 1Password. macOS wraps Herd's
# composer; Linux/WSL2 wraps the Nix one. Without op or the env file it runs
# composer unchanged.
function composer --description 'composer with 1Password-injected GitHub OAuth when available'
{{- if eq .chezmoi.os "darwin" }}
    set -l real "$HOME/Library/Application Support/Herd/bin/composer"
{{- else }}
    set -l real (command -s composer)
{{- end }}
    if type -q op; and test -r "$HOME/.config/1password/composer.env"
        op run --env-file="$HOME/.config/1password/composer.env" -- sh -c '
    export COMPOSER_AUTH="{\"github-oauth\":{\"github.com\":\"$GITHUB_COMPOSER_TOKEN\"}}"
    exec "$@"
  ' sh "$real" $argv
    else
        $real $argv
    end
end

function op-refresh --description 'sign into 1Password then reload fish config'
    op signin; and source "$HOME/.config/fish/config.fish"
end
