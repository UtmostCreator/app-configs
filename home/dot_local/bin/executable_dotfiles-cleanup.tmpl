#!/usr/bin/env bash
# Safe, non-destructive cleanup (store optimise + cache prune; keeps all
# rollback generations). Pass --gc to also reclaim aged generations.
# Installed to ~/.local/bin by chezmoi; usable from any shell, anywhere.
set -euo pipefail
DOTFILES_DIR="{{ .chezmoi.sourceDir | trimSuffix "/home" }}"
exec bash "$DOTFILES_DIR/scripts/cleanup.sh" --apply "$@"
