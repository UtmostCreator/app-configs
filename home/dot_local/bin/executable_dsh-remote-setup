#!/usr/bin/env bash
# Finish or inspect private Android access to DeepSeek Harness.
set -euo pipefail

usage() {
  printf 'Usage: dsh-remote-setup [--autostart] [-h|--help]\n'
  printf 'Joins Tailscale, serves http://127.0.0.1:$DSH_REMOTE_PORT (default 3080) and\n'
  printf 'starts the dsh-remote systemd user service now. It is NOT enabled for login\n'
  printf 'autostart unless you pass --autostart (enable --now); with user lingering it\n'
  printf 'keeps running until reboot or: systemctl --user stop dsh-remote.service\n'
  printf 'The Tailscale Serve rule persists; remove it with: tailscale serve reset\n'
  printf '(this clears all Serve rules). Linux only.\n'
}

autostart=0
case "$#:${1:-}" in
  0:) ;;
  1:-h | 1:--help) usage; exit 0 ;;
  1:--autostart) autostart=1 ;;
  *) printf 'dsh-remote-setup: unknown argument(s): %s\n' "$*" >&2; usage >&2; exit 2 ;;
esac

# Everything below needs systemd and ss; refuse before any mutation.
if [[ "$(uname -s)" != Linux ]]; then
  printf 'dsh-remote-setup: Linux only (needs systemd --user); nothing changed.\n' >&2
  exit 69
fi

port="${DSH_REMOTE_PORT:-3080}"

command -v tailscale >/dev/null 2>&1 || {
  printf 'Tailscale is not installed. On NixOS run: sudo sys-setup --apply\n' >&2
  exit 69
}

if ! tailscale status >/dev/null 2>&1; then
  printf 'Joining this PC to Tailscale (complete the browser sign-in if prompted)...\n'
  tailscale up
fi

printf 'Configuring private HTTPS proxy to http://127.0.0.1:%s ...\n' "$port"
tailscale serve --bg "$port"

systemctl --user daemon-reload
if systemctl --user is-active --quiet dsh-remote.service; then
  printf 'dsh-remote.service is already running.\n'
  if [[ "$autostart" == 1 ]]; then systemctl --user enable dsh-remote.service; fi
elif ss -ltn "sport = :$port" | grep -q LISTEN; then
  printf 'Port %s is owned by an existing Harness process; leaving it untouched.\n' "$port"
  printf 'When its agents are finished, run: systemctl --user start dsh-remote.service\n'
  if [[ "$autostart" == 1 ]]; then systemctl --user enable dsh-remote.service; fi
elif [[ "$autostart" == 1 ]]; then
  systemctl --user enable --now dsh-remote.service
else
  systemctl --user start dsh-remote.service
fi
if systemctl --user is-enabled --quiet dsh-remote.service 2>/dev/null; then
  printf 'Autostart at login: enabled (disable: systemctl --user disable dsh-remote.service)\n'
else
  printf 'Autostart at login: off (opt in: dsh-remote-setup --autostart)\n'
fi

printf '\nTailscale Serve status:\n'
tailscale serve status

tailnet_host="$(tailscale status --json | jq -r '.Self.DNSName // empty' | sed 's/\.$//')"
token_url="$(journalctl --user-unit=dsh-remote.service --no-pager -o cat 2>/dev/null \
  | sed -n 's#^dsh web: http://127\.0\.0\.1:[0-9][0-9]*/?token=\(.*\)$#\1#p' \
  | tail -n 1)"
printf '\nAndroid base URL: https://%s\n' "$tailnet_host"
if [[ -n "$token_url" ]]; then
  printf 'First-use URL:    https://%s/?token=%s\n' "$tailnet_host" "$token_url"
else
  printf 'The one-time first-use URL will appear after the managed Harness service starts.\n'
  printf 'Retrieve it with: dsh-remote-status\n'
fi
