# Workspace launcher aliases (sourced from ~/.zshrc).
#
# Type `ws` to open the tmux dev workspace: panes are created, repos are
# checked and updated, services start, logs are captured, and verification runs
# before the git workflow. Scripts live in ops/projects/ of the app-configs repo.
#
#   ws                  open the full tmux workspace (ops/projects/tmux/master.sh)
#   ws-restart          stop the workspace, refresh repo state, open it again
#   ws-stop             stop the tmux workspace
#   ws-verify           verify tmux, Herd, Redis, backend, integration, frontend, logs
#   ws-logs             run the backend log watcher
#   ws-stack            start Herd, Colima, Redis and the backend npm dev server
#   ws-frontend         start the web-frontend dev server (netlify dev)
#   ws-frontend-restart restart only the frontend pane/process
#   ws-frontend-debug   start/stop/status/logs helper for standalone frontend debugging
#   ws-components-local pack ui-components and install the tarball into web-frontend
#                       (apply | refresh | watch | rollback | status; --start-dev)
#   ws-health           live health dashboard   ws-health-once  single snapshot
#   ws-fix              interactive fix picker for health failures
#   log-workspace       persistent lnav log investigation workspace
#   log-errors          error report over log files (restsift: res log-errors)
#   kill-logs           stop log capture/watch processes

WS_PROJECTS_DIR="${WS_PROJECTS_DIR:-{{ joinPath .chezmoi.sourceDir ".." "ops" "projects" }}}"
WS_LOGGING_DIR="$WS_PROJECTS_DIR/logging"
WS_HEALTH_DIR="$WS_PROJECTS_DIR/health"

alias ws="bash $WS_PROJECTS_DIR/tmux/master.sh"
alias ws-start="bash $WS_PROJECTS_DIR/tmux/master.sh"
alias ws-restart="bash $WS_PROJECTS_DIR/workspace/restart.sh"
alias ws-stop="bash $WS_PROJECTS_DIR/workspace/stop.sh"
alias ws-verify="bash $WS_HEALTH_DIR/verify-workspace.sh"
alias ws-logs="bash $WS_LOGGING_DIR/watch/watch.sh"
alias ws-stop-logs="bash $WS_LOGGING_DIR/watch/stop-watch.sh"
alias ws-stack="bash $WS_PROJECTS_DIR/workspace/stack/start.sh"
alias ws-stop-stack="bash $WS_PROJECTS_DIR/workspace/stack/stop.sh"
alias ws-frontend="bash $WS_PROJECTS_DIR/workspace/frontend/start.sh"
alias ws-stop-frontend="bash $WS_PROJECTS_DIR/workspace/frontend/stop.sh"
alias ws-frontend-restart="bash $WS_PROJECTS_DIR/workspace/frontend/restart.sh"
alias ws-frontend-debug="bash $WS_PROJECTS_DIR/workspace/frontend/debug.sh"
alias ws-components-local="bash $WS_PROJECTS_DIR/workspace/components-local.sh"
alias ws-health-raw="bash $WS_HEALTH_DIR/monitor.sh"
alias ws-fix="bash $WS_PROJECTS_DIR/workspace/fix.sh"
alias log-workspace="bash $WS_LOGGING_DIR/watch/run.sh"
alias log-errors='res log-errors'  # lives in restsift now
alias kill-logs="bash $WS_LOGGING_DIR/kill-logs.sh"

unalias ws-health 2>/dev/null || true
unfunction ws-health ws-health-once 2>/dev/null || true
alias ws-health="bash $WS_HEALTH_DIR/dashboard.sh"
alias ws-health-once="bash $WS_HEALTH_DIR/dashboard.sh --once"
