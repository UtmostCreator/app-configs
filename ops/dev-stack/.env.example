# Copy to .env (setup.sh does this for you) and replace every change-me value.
# .env is git-ignored. Never commit real credentials.

# Compose project name (lowercase letters, numbers, '_' and '-')
COMPOSE_PROJECT_NAME=devstack

# Host port bindings - change these if anything clashes with local services
EXAMPLE_APP_PORT=8080
MARIADB_HOST_PORT=3306
REDIS_HOST_PORT=6380
DEVSTACK_PUBLISH_DATA_PORTS=false
DEVSTACK_INFRA_MEMORY_LIMIT=512m
DEVSTACK_PHP_MEMORY_LIMIT=1g
DEVSTACK_TOOLS_MEMORY_LIMIT=1g
DEVSTACK_NGINX_MEMORY_LIMIT=256m

# Set to true to make setup.sh verify private npm registry credentials
# (see scripts/setup-npm-auth.sh); DEVSTACK_NPM_REGISTRY is the registry base URL
DEVSTACK_REQUIRE_NPM_AUTH=false
DEVSTACK_NPM_REGISTRY=https://npm.example.test

# Database credentials (used when MariaDB creates the local users)
MARIADB_ROOT_PASSWORD=change-me
EXAMPLE_APP_DB_PASSWORD=change-me
EXAMPLE_APP_TEST_DB_PASSWORD=change-me

# Password for the local admin user created by seed.sh
EXAMPLE_APP_ADMIN_PASSWORD=change-me
