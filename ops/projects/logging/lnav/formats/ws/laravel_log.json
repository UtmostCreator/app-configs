{
  "$schema": "https://lnav.org/schemas/format-v1.schema.json",
  "backend_laravel_log": {
    "title": "backend Laravel",
    "description": "Laravel application logs used by the backend and Integration workspaces",
    "file-pattern": "/(?:integration|backend)/storage/logs/laravel(?:-[0-9]{4}-[0-9]{2}-[0-9]{2})?\\.log$",
    "regex": {
      "correlated": {
        "pattern": "^\\[(?<timestamp>[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2})\\] (?<environment>[A-Za-z0-9_-]+)\\.(?<level>[A-Za-z]+):[ ]?(?<body>.*?[\\\"](?<correlation_key>request_id|trace_id|job_id|user_id)[\\\"]\\s*:\\s*[\\\"]?(?<correlation_id>[A-Za-z0-9._:-]+)[\\\"]?.*)$"
      },
      "standard": {
        "pattern": "^\\[(?<timestamp>[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2})\\] (?<environment>[A-Za-z0-9_-]+)\\.(?<level>[A-Za-z]+):[ ]?(?!.*[\\\"](?:request_id|trace_id|job_id|user_id)[\\\"]\\s*:)(?<body>.*)$"
      }
    },
    "timestamp-format": ["%Y-%m-%d %H:%M:%S"],
    "level-field": "level",
    "body-field": "body",
    "ordered-by-time": true,
    "multiline": true,
    "value": {
      "environment": {
        "kind": "string",
        "identifier": true
      },
      "level": {
        "kind": "string"
      },
      "body": {
        "kind": "string"
      },
      "correlation_key": {
        "kind": "string",
        "identifier": true
      },
      "correlation_id": {
        "kind": "string",
        "identifier": true
      }
    },
    "sample": [
      {
        "line": "[2026-09-03 09:42:18] local.INFO: Request completed {\"request_id\":\"req-123\",\"status\":200}",
        "level": "info"
      },
      {
        "line": "[2026-09-03 09:42:19] local.ERROR: Upstream request failed {\"trace_id\":\"trace-456\"}",
        "level": "error"
      },
      {
        "line": "[2026-09-03 09:42:20] local.WARNING: Slow query completed in 850ms",
        "level": "warning"
      }
    ]
  }
}
