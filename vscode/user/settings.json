  // DEBUG
  // =========================================================
  "debug.inlineValues": "auto",
  "debug.toolBarLocation": "docked",
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.showInlineBreakpointCandidates": true,
  "debug.openDebug": "openOnDebugBreak",
  // =========================================================
  // EXTENSION-SPECIFIC ENHANCEMENTS
  // =========================================================
  // Path IntelliSense
  "path-intellisense.autoSlashAfterDirectory": true,
  "path-intellisense.extensionOnImport": false,
  // Error Lens (if installed)
  "errorLens.enabled": true,
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning"
  ],
  "errorLens.fontSize": "0.9em",
  // GitLens enhancements
  "gitlens.codeLens.enabled": true,
  "gitlens.codeLens.authors.enabled": false, // Reduce noise
  "gitlens.codeLens.recentChange.enabled": true,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.statusBar.enabled": true,
  "gitlens.views.branches.branches.layout": "tree",
  "gitlens.views.commits.files.layout": "tree",
  // Bookmarks (if installed)
  "bookmarks.saveBookmarksInProject": true,
  "bookmarks.navigateThroughAllFiles": true,
  // TODO Tree (if installed)
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "BUG",
    "HACK",
    "NOTE",
    "XXX"
  ],
  "todo-tree.highlights.defaultHighlight": {
    "icon": "alert",
    "type": "text",
    "foreground": "#fff",
    "background": "#ffbd2e",
    "opacity": 50,
    "iconColour": "#ffbd2e"
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "iconColour": "#00ff00"
    },
    "FIXME": {
      "icon": "alert",
      "iconColour": "#ff0000"
    },
    "BUG": {
      "icon": "bug",
      "iconColour": "#ff0000"
    }
  },
  "workbench.editor.tabActionLocation": "right",
